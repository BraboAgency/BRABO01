generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  TECHNICIAN
  RECEPTION
  CUSTOMER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
  NO_SHOW
}

enum PipelineStatus {
  RECIBIDO
  REVISION
  PRUEBA_MANEJO
  SERVICIO
  PREPARACION
  LISTO
}

enum InvoiceStatus {
  SOLICITADA
  EN_PROCESO
  ENVIADA
  RECHAZADA
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointmentsAssigned Appointment[] @relation("AssignedMechanic")
  createdAppointments  Appointment[] @relation("CreatedBy")
  statusEvents         AppointmentStatusEvent[]
  consumables          Consumable[]
  refreshTokens        RefreshToken[]
  auditEvents          AuditEvent[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Customer {
  id                     String   @id @default(uuid())
  name                   String
  email                  String
  phone                  String
  notificationEmail      Boolean  @default(true)
  notificationWhatsApp   Boolean  @default(false)
  notificationPush       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  vehicles     Vehicle[]
  appointments Appointment[]
}

model Vehicle {
  id         String   @id @default(uuid())
  customerId String
  make       String
  model      String
  year       Int
  plate      String?
  vin        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer     Customer @relation(fields: [customerId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id                 String             @id @default(uuid())
  customerId         String
  vehicleId          String
  scheduledAt        DateTime
  status             AppointmentStatus  @default(SCHEDULED)
  pipelineStatus     PipelineStatus     @default(RECIBIDO)
  assignedMechanicId String?
  createdById        String?
  checkInAt          DateTime?
  checkInNotes       String?
  odometer           Int?
  eta                DateTime?
  trackingCode       String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  assignedMechanic User?   @relation("AssignedMechanic", fields: [assignedMechanicId], references: [id])
  createdBy        User?   @relation("CreatedBy", fields: [createdById], references: [id])
  statusEvents     AppointmentStatusEvent[]
  consumables      Consumable[]
  invoiceRequests  InvoiceRequest[]
  notificationLogs NotificationLog[]
}

model AppointmentStatusEvent {
  id             String         @id @default(uuid())
  appointmentId  String
  pipelineStatus PipelineStatus
  notes          String?
  createdById    String?
  createdAt      DateTime       @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  createdBy   User?       @relation(fields: [createdById], references: [id])
}

model Consumable {
  id            String   @id @default(uuid())
  appointmentId String
  oilBrand      String
  oilSpec       String
  oilQuantity   Float
  filterBrand   String?
  filterCode    String?
  applies       Boolean  @default(true)
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])
}

model InvoiceRequest {
  id            String        @id @default(uuid())
  appointmentId String
  status        InvoiceStatus @default(SOLICITADA)
  note          String?
  pdfUrl        String?
  requestedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model NotificationLog {
  id            String               @id @default(uuid())
  appointmentId String
  channel       NotificationChannel
  destination   String
  template      String
  payload       Json
  status        NotificationStatus  @default(PENDING)
  createdAt     DateTime            @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
